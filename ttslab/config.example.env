# Настройки TTS Lab. Скопируйте в config.env и поменяйте при необходимости.

# Панель (страница теста и управления)
PANEL_HOST=0.0.0.0
PANEL_PORT=8800
# Пароль на панель (пусто — без пароля). Логин любой.
PANEL_PASSWORD=

# API модели — его подключаете в LiteLLM (8000 занят Whisper, 8880 — Джарвис)
TTS_HOST=0.0.0.0
TTS_PORT=8890
# Ключ, который LiteLLM передаёт на Мак (как у Whisper). none — без ключа
TTS_API_KEY=lm-studio

# LiteLLM: адрес и имя модели, под которым она там заведена
LITELLM_URL=http://litellm.edu.ingacademy.ru
LITELLM_MODEL_NAME=mac-tts

# Не давать Маку засыпать, пока работает модель
USE_CAFFEINATE=1
# При запуске ./start.sh поднять модель, которая работала в прошлый раз
AUTOSTART_LAST=1
