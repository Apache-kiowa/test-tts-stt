# Настройки TTS Lab (Linux). Скопируйте в config.env и поменяйте при необходимости.

# Панель (страница теста и управления)
PANEL_HOST=0.0.0.0
PANEL_PORT=8800
# Пароль на панель (пусто — без пароля). Логин любой.
PANEL_PASSWORD=

# API модели в локальной сети (OpenAI-совместимый /v1/audio/speech)
TTS_HOST=0.0.0.0
TTS_PORT=8890
# Ключ для API (пусто — без ключа, удобно в доверенной локальной сети)
TTS_API_KEY=
# Имя модели в ответе /v1/models (клиенты могут слать любое)
MODEL_ALIAS=local-tts

# При запуске панели поднять модель, которая работала в прошлый раз
AUTOSTART_LAST=1
